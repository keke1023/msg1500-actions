#
# RAISECOM MSG1500 X.00 种子配置
# 底座：coolsnowwolf/lede @ 20251001（ramips/mt7621，内核 5.10，opkg）
# 说明：
#   * make defconfig 会自动补全依赖；被删掉的 rust 包符号会被自动丢弃
#   * MSG1500 设备默认 DEVICE_PACKAGES 不带任何 WiFi 驱动，故 WiFi 驱动在此显式勾选
#   * mt7615d（闭源，默认）模式：kmod-mt7615d + luci-app-mtwifi
#     mt7615e（开源，兜底）模式：workflow 会删去上面两行并加 kmod-mt7615e
#

# ---------- 目标设备 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_raisecom_msg1500-x-00=y
# 旧式符号兜底（defconfig 会保留有效的一个）
CONFIG_TARGET_ramips_mt7621_DEVICE_raisecom_msg1500-x-00=y

# ---------- LuCI 基础 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-ssl=y

# ---------- 内网穿透（需求项）----------
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-app-ngrokc=y
CONFIG_PACKAGE_ngrokc=y
CONFIG_PACKAGE_luci-i18n-ngrokc-zh-cn=y

# ---------- helloworld（master）：SSR+ / Xray ----------
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# ---------- MT7615 闭源驱动（mt7615d 模式默认）----------
# lede 自带 package/lean/mt/{drivers/mt7615d, luci-app-mtwifi}
CONFIG_PACKAGE_kmod-mt7615d=y
CONFIG_PACKAGE_luci-app-mtwifi=y
# 固件（设备默认会带，这里显式保险）
CONFIG_PACKAGE_kmod-mt7615-firmware=y

# ---------- Node.js 版本选择（关键：避免 host node 编译失败）----------
# MSG1500 是 mipsel，lede 的 node 包默认 choice 选 NODEJS_12（v12.22.12），
# 而 v12 的 configure 强制要求 Python 2.7，在 GitHub ubuntu-22.04 runner 上直接失败。
# 显式选 v18（CONFIG_NODEJS_18）：coolsnowwolf/packages 里 v18.15.0 用 python3/host，
# 且 gcc 11 可正常编译，彻底绕开 py2 死穴。其余包（golang/frp/ngrokc 等）不受影响。
CONFIG_NODEJS_18=y
