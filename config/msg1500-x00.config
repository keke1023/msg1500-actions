#
# RAISECOM MSG1500 X.00（别名 Nokia A-040W-Q）种子配置
# 底座：ImmortalWrt openwrt-21.02（ramips/mt7621，内核 5.4）
# 说明：make defconfig 会自动补全依赖；被删掉的 rust 包符号会被自动丢弃
#

# ---------- 目标设备 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_raisecom_msg1500-x-00=y

# ---------- LuCI 基础 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---------- 内网穿透（需求项）----------
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-app-ngrokc=y
CONFIG_PACKAGE_ngrokc=y
CONFIG_PACKAGE_luci-i18n-ngrokc-zh-cn=y

# ---------- helloworld（master）：SSR+ / Xray ----------
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# 只用 Xray，关掉用不到的核心
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan is not set

# ---------- rust 全部关闭（feed 目录已物理删除，这里双保险）----------
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadow_Tls is not set
# CONFIG_PACKAGE_shadowsocks-rust is not set
# CONFIG_PACKAGE_dns2socks-rust is not set
# CONFIG_PACKAGE_shadow-tls is not set

# ---------- MT7615 闭源驱动（mt7615d 模式时由 DEVICE_PACKAGES 自动带入；----------
# ---------- mt7615e 开源模式下这些符号不存在，defconfig 会自动丢弃）----------
CONFIG_PACKAGE_kmod-mt7615d=y
CONFIG_PACKAGE_luci-app-mtwifi=y
